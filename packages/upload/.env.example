# @repo/upload — storage credentials (Cloudflare R2 / AWS S3)
# Server-only. Never expose these to the client / commit real values.

# ---- Required ----
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# ---- Cloudflare R2 ----
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com (your R2 account id).
# Keep region "auto" for R2.
S3_ENDPOINT=""
S3_REGION="auto"

# ---- AWS S3 (instead of R2) ----
# Leave S3_ENDPOINT empty and set a real region:
# S3_REGION="us-east-1"

# ---- Optional ----
# Public/CDN base URL for building public object URLs (public buckets only).
S3_PUBLIC_BASE_URL=""
# Path-style addressing ("true"/"false"). Defaults on for custom endpoints.
S3_FORCE_PATH_STYLE=""
